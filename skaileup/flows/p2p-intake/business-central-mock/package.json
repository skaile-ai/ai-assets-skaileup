{
  "name": "@skaile/business-central-mock-mcp",
  "version": "0.1.0",
  "description": "DEMO-GRADE mock Business Central MCP server for the Getec p2p-intake demo flow. Exposes get_supplier / create_po_draft / post_po over an in-memory store. In production, Getec's SAP BTP MCP layer plays this role.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "business-central-mock-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.9",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node20",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "bun run src/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
