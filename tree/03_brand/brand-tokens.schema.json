{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skaile:schema:brand-tokens",
  "title": "Brand design tokens (DTCG 2025.10 subset)",
  "description": "The required subset of _concept/03_brand/brand.tokens.json. Shape and flattening rules: tree/03_brand/brand.tokens.md. Open elsewhere: more groups and tokens are allowed.",
  "x-artifact": "_concept/03_brand/brand.tokens.json",
  "type": "object",
  "required": ["$extensions", "color", "font", "radius", "spacing", "shadow"],
  "properties": {
    "$extensions": {
      "type": "object",
      "required": ["ai.skaile"],
      "properties": {
        "ai.skaile": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["light", "dark"] },
            "approved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      }
    },
    "color": {
      "type": "object",
      "required": [
        "primary", "secondary", "accent", "background", "surface", "text",
        "text-muted", "border", "error", "success", "warning"
      ],
      "properties": {
        "primary": { "$ref": "#/$defs/colorToken" },
        "secondary": { "$ref": "#/$defs/colorToken" },
        "accent": { "$ref": "#/$defs/colorToken" },
        "background": { "$ref": "#/$defs/colorToken" },
        "surface": { "$ref": "#/$defs/colorToken" },
        "text": { "$ref": "#/$defs/colorToken" },
        "text-muted": { "$ref": "#/$defs/colorToken" },
        "border": { "$ref": "#/$defs/colorToken" },
        "error": { "$ref": "#/$defs/colorToken" },
        "success": { "$ref": "#/$defs/colorToken" },
        "warning": { "$ref": "#/$defs/colorToken" }
      }
    },
    "font": {
      "type": "object",
      "required": ["heading", "body", "mono"],
      "properties": {
        "heading": { "$ref": "#/$defs/fontFamilyToken" },
        "body": { "$ref": "#/$defs/fontFamilyToken" },
        "mono": { "$ref": "#/$defs/fontFamilyToken" }
      }
    },
    "radius": {
      "type": "object",
      "required": ["base"],
      "properties": { "base": { "$ref": "#/$defs/dimensionToken" } }
    },
    "spacing": {
      "type": "object",
      "required": ["base"],
      "properties": { "base": { "$ref": "#/$defs/dimensionToken" } }
    },
    "shadow": {
      "type": "object",
      "required": ["sm", "md", "lg"],
      "properties": {
        "sm": { "$ref": "#/$defs/shadowToken" },
        "md": { "$ref": "#/$defs/shadowToken" },
        "lg": { "$ref": "#/$defs/shadowToken" }
      }
    }
  },
  "$defs": {
    "colorValue": {
      "type": "object",
      "required": ["colorSpace", "components", "hex"],
      "properties": {
        "colorSpace": { "type": "string" },
        "components": {
          "type": "array",
          "minItems": 3,
          "items": { "type": ["number", "string"] }
        },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "dimensionValue": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "enum": ["px", "rem"] }
      }
    },
    "shadowObject": {
      "type": "object",
      "required": ["color", "offsetX", "offsetY", "blur", "spread"],
      "properties": {
        "color": { "$ref": "#/$defs/colorValue" },
        "offsetX": { "$ref": "#/$defs/dimensionValue" },
        "offsetY": { "$ref": "#/$defs/dimensionValue" },
        "blur": { "$ref": "#/$defs/dimensionValue" },
        "spread": { "$ref": "#/$defs/dimensionValue" },
        "inset": { "type": "boolean" }
      }
    },
    "colorToken": {
      "type": "object",
      "required": ["$type", "$value"],
      "properties": {
        "$type": { "const": "color" },
        "$value": { "$ref": "#/$defs/colorValue" }
      }
    },
    "fontFamilyToken": {
      "type": "object",
      "required": ["$type", "$value"],
      "properties": {
        "$type": { "const": "fontFamily" },
        "$value": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        }
      }
    },
    "dimensionToken": {
      "type": "object",
      "required": ["$type", "$value"],
      "properties": {
        "$type": { "const": "dimension" },
        "$value": { "$ref": "#/$defs/dimensionValue" }
      }
    },
    "shadowToken": {
      "type": "object",
      "required": ["$type", "$value"],
      "properties": {
        "$type": { "const": "shadow" },
        "$value": {
          "oneOf": [
            { "$ref": "#/$defs/shadowObject" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shadowObject" } }
          ]
        }
      }
    }
  }
}
