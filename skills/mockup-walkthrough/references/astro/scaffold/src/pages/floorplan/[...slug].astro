---
import specs from '../../data/specs.json';

export function getStaticPaths() {
  return (specs as any).screens
    .filter((screen: any) => screen.floorplan_frame_html)
    .map((screen: any) => ({
      params: { slug: screen.screen_id },
      props: { frame: screen.floorplan_frame_html },
    }));
}

const { frame } = Astro.props as any;
---
<Fragment set:html={frame} />
